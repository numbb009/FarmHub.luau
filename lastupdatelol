local function StyleElement(instance, radius, strokeColor, strokeThick, addBorderGradient)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or Theme.CornerRadius
    corner.Parent = instance
    
    if strokeColor then
        local stroke = Instance.new("UIStroke")
        stroke.Color = strokeColor
        stroke.Thickness = strokeThick or 1.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Transparency = 0.1
        stroke.Parent = instance
        
        if addBorderGradient then
            local grad = Instance.new("UIGradient")
            grad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(240, 30, 30)), 
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 5, 5)),   
                ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))       
            }
            grad.Rotation = 45 
            grad.Parent = stroke
        end
        return corner, stroke
    end
    return corner
end

