StartManagedThread("CoreModifierPersistenceLoop", function()
    while not stopAll do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        
        if hum and root then
            hum.WalkSpeed = modifications.WalkSpeed
            hum.UseJumpPower = true
            hum.JumpPower = modifications.JumpPower
            
            -- AUTOMATED CALCULATION: Replaced threshold % slider with a dynamic auto-die check boundary (25% health alert)
            if modifications.EscapeEnabled then
                local hpPercent = (hum.Health / hum.MaxHealth) * 100
                if hpPercent <= 25 and hum.Health > 0 then
                    root.CFrame = CFrame.new(modifications.SafeZoneCoordinates)
                    warn("CRITICAL PANIC SAFE Teleport WARP EXECUTED!")
                    task.wait(3) 
                end
            end
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
                local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
                
