-- 2. 5k Dummy Teleport + Farm
CreateButton(ScrollFrame, "Teleport + Farm (5k Dummy)", function()
    task.spawn(function()
        local map = workspace:FindFirstChild("MAP")
        if not map then return end

        local dummiesFolder = map:FindFirstChild("5k_dummies")
        if not dummiesFolder then return end

        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("jdskhfsIIIllliiIIIdchgdIiIIIlIlIli")
        if not remote then return end

        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local dummyIndex = 4

        local targetDummy = nil
        for i = 1, 50 do
            local children = dummiesFolder:GetChildren()
            if #children >= dummyIndex then
                targetDummy = children[dummyIndex]
                if targetDummy:FindFirstChild("Humanoid") and targetDummy:FindFirstChild("HumanoidRootPart") then
                    break
                end
            end
            task.wait(0.1)
        end

        if not targetDummy then
            warn("ERROR: Dummy index " .. dummyIndex .. " not found! Try changing the index number.")
            return
        end

        local targetHumanoid = targetDummy.Humanoid
        local targetRoot = targetDummy.HumanoidRootPart

        root.CFrame = targetRoot.CFrame * CFrame.new(0, 5, 0)
        task.wait(0.2)

        while not stopAll do
            if not targetDummy.Parent or targetHumanoid.Health <= 0 then
                warn("Target died! Stopping.")
                break
            end

            local args = {
                [1] = targetHumanoid,
                [2] = 1
            }

            pcall(function()
                remote:FireServer(unpack(args))
            end)

            task.wait(math.random(4, 7)/10)
        end
    end)
end)

-- 3. Fireball Farm
CreateButton(ScrollFrame, "Fireball Farm", function()
    task.spawn(function()
        local remote = ReplicatedStorage:WaitForChild("SkillsInRS", 9e9):WaitForChild("RemoteEvent", 9e9)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = char:WaitForChild("HumanoidRootPart")

        while not stopAll do
            local dummies = GetCurrentDummyFolder()
            if not dummies then task.wait(0.5) continue end

            local nearest = nil
            local shortestDist = math.huge
            for _, dummy in pairs(dummies:GetChildren()) do
                local hrp = dummy:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - root.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearest = dummy
                    end
                end
            end

            if nearest and nearest:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    remote:FireServer(nearest.HumanoidRootPart.Position, "NewFireball")
                end)
            end

            wait(math.random(15, 25)/10)
        end
    end)
end)

