-- Zone detection for fireball and lightning ball
local function GetCurrentDummyFolder()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local k5AreaCenter = Vector3.new(-79, 593, 814)
    local regularAreaCenter = Vector3.new(-131, 642, 575)

    local distanceToK5 = (root.Position - k5AreaCenter).Magnitude
    local distanceToRegular = (root.Position - regularAreaCenter).Magnitude

    local map = Workspace:FindFirstChild("MAP")
    if not map then return nil end

    if distanceToK5 < distanceToRegular then
        return map:FindFirstChild("5k_dummies")
    else
        return map:FindFirstChild("dummies")
    end
end

