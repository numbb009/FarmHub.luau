    label.BackgroundTransparency = 1
    label.Text = featureName
    label.TextColor3 = Theme.TextMuted
    label.TextSize = 13
    label.Font = Theme.FontMain
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 36, 0, 18)
    switch.Position = UDim2.new(1, -36, 0.5, -9)
    switch.BackgroundColor3 = startState and Theme.AccentActive or Color3.fromRGB(40, 40, 45)
    switch.Text = ""
    switch.Parent = row
    StyleElement(switch, UDim.new(1, 0))

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 14, 0, 14)
    pill.Position = startState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    pill.BackgroundColor3 = Theme.TextPrimary
    pill.BorderSizePixel = 0
    pill.Parent = switch
    StyleElement(pill, UDim.new(1, 0))

    local active = startState
    switch.MouseButton1Click:Connect(function()
        active = not active
        local targetPos = active and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local targetColor = active and Theme.AccentActive or Color3.fromRGB(40, 40, 45)
        TweenService:Create(pill, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = targetPos}):Play()
        TweenService:Create(switch, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(label, TweenInfo.new(0.15), {TextColor3 = active and Theme.TextPrimary or Theme.TextMuted}):Play()
        callback(active)
    end)
end

local function CreateSlider(parent, sliderName, min, max, startValue, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -40, 0, 16)
    label.BackgroundTransparency = 1
    label.Text = sliderName
    label.TextColor3 = Theme.TextMuted
    label.TextSize = 12
    label.Font = Theme.FontMain
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 40, 0, 16)
    valueLabel.Position = UDim2.new(1, -40, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(startValue)
    valueLabel.TextColor3 = Theme.TextPrimary
    valueLabel.TextSize = 12
    valueLabel.Font = Theme.FontMain
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = row

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = row
    StyleElement(track, UDim.new(1, 0))

    local fill = Instance.new("Frame")
    local startPercent = math.clamp((startValue - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(startPercent, 0, 1, 0)
    fill.BackgroundColor3 = Theme.AccentActive
    fill.BorderSizePixel = 0
    fill.Parent = track
    StyleElement(fill, UDim.new(1, 0))

    local sliderDragging = false

    local function UpdateSliderInput(input)
        local absoluteWidth = track.AbsoluteSize.X
        local relativeX = input.Position.X - track.AbsolutePosition.X
        local percentage = math.clamp(relativeX / absoluteWidth, 0, 1)
        TweenService:Create(fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {Size = UDim2.new(percentage, 0, 1, 0)}):Play()
        local snapValue = math.floor(min + (percentage * (max - min)))
        valueLabel.Text = tostring(snapValue)
        callback(snapValue)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = true
            UpdateSliderInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSliderInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = false
        end
    end)
end   

