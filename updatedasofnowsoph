-- ==========================================
local function ClearDrawings()
    for _, folder in pairs(drawingFolders) do
        if folder then folder:Destroy() end
    end
    drawingFolders = {}
end

local function StopAllScripts()
    stopAll = true
    for name, thread in pairs(activeThreads) do
        pcall(function() task.cancel(thread) end)
    end
    activeThreads = {}
    ClearDrawings()
    warn("ALL MODULES DEACTIVATED")
end

local function StartManagedThread(name, func)
    if activeThreads[name] then
        pcall(function() task.cancel(activeThreads[name]) end)
        activeThreads[name] = nil
    end
    stopAll = false
    activeThreads[name] = task.spawn(func)
end

